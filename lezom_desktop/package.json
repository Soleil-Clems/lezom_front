{
  "name": "lezom-desktop",
  "version": "1.0.0",
  "description": "Lezom Desktop App",
  "main": "dist/main.js",
  "scripts": {
    "compile": "tsc",
    "start": "npm run compile && ELECTRON_RUN_AS_NODE= electron .",
    "build:mac": "npm run compile && ELECTRON_RUN_AS_NODE= electron-builder --mac",
    "build:win": "npm run compile && ELECTRON_RUN_AS_NODE= electron-builder --win",
    "build:linux": "npm run compile && ELECTRON_RUN_AS_NODE= electron-builder --linux"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "electron": "^33.4.11",
    "electron-builder": "^25.0.0",
    "typescript": "^5.0.0"
  }
}
